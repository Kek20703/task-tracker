# Образец настроек. Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает.

# Postgres
POSTGRES_DB=task_tracker
POSTGRES_USER=task_tracker
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Kafka: порт для приложений, запущенных с хоста
KAFKA_EXTERNAL_PORT=29092

# Mailpit: локальный SMTP и веб-интерфейс с пойманными письмами
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Backend: секрет подписи JWT, не короче 32 символов. Обязательно задать свой: openssl rand -hex 32
# С пустым значением сервис не стартует — так и задумано, общего секрета по умолчанию нет.
JWT_SECRET=

# Summarization: без ключа сервис работает в режиме-заглушке.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=10s
